# Local Docker configuration for Traffic AI System
# Copy this file to .env and replace every placeholder before use.
# Never commit docker/.env.

MONGO_INITDB_ROOT_USERNAME=smartroad_admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-local-password
MONGO_INITDB_DATABASE=smartroad
JWT_SECRET=replace-with-a-long-random-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

NODE_ENV=development
BACKEND_PORT=5000
AI_PORT=8000
CLIENT_URL=http://localhost:3000
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
